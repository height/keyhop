{
  "name": "keyhop",
  "version": "0.1.0",
  "description": "KeyHop: a macOS menu bar app launcher with global shortcuts and optional proxy settings.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/height/keyhop.git"
  },
  "homepage": "https://github.com/height/keyhop#readme",
  "bugs": {
    "url": "https://github.com/height/keyhop/issues"
  },
  "keywords": ["macos", "launcher", "menu-bar", "keyboard-shortcuts", "proxy"],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "bin": {
    "keyhop": "bin/keyhop.mjs",
    "proxy-launcher": "bin/keyhop.mjs"
  },
  "scripts": {
    "build:mac": "bash scripts/build-macos.sh",
    "build:mac:native": "bash scripts/build-macos.sh --native",
    "check": "node --check bin/keyhop.mjs && node --check lib/cli.mjs && node --check scripts/verify-package.mjs",
    "test": "node --test test/*.test.mjs",
    "test:mac": "bash scripts/test-macos.sh",
    "test:hotkeys": "bash scripts/test-hotkeys.sh",
    "test:package": "bash scripts/test-package.sh",
    "prepack": "node scripts/verify-package.mjs"
  },
  "files": ["bin/", "lib/", "dist/KeyHop.app/", "dist/build-info.json", "README.md", "docs/"],
  "engines": {
    "node": ">=20"
  },
  "os": ["darwin"],
  "cpu": ["arm64", "x64"]
}
